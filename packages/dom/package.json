{
  "name": "@cue-engine/dom",
  "version": "0.1.0",
  "description": "Browser DOM renderer for Cue Engine.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "captions",
    "subtitles",
    "renderer",
    "video",
    "dom",
    "accessibility"
  ],
  "author": "AFOLAYAN Timileyin Israel",
  "license": "MIT",
  "dependencies": {
    "@cue-engine/core": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.9",
    "tsdown": "^0.22.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  }
}
